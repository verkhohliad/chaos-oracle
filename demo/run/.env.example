# ============================================================================
# ChaosOracle Sepolia Demo — Environment Variables
# ============================================================================
# Copy to .env and fill in your values.
# DO NOT commit .env to version control.

# ── Network ──
SEPOLIA_RPC=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ── Deployer (must be the owner of ChaosCore + RewardsDistributor) ──
DEPLOYER_PRIVATE_KEY=0x...
# Public address of deployer (derived from DEPLOYER_PRIVATE_KEY)
# Used as the Gateway's default signer for RewardsDistributor calls
DEPLOYER_ADDRESS=0x...

# ── Agent Keys (workers + verifiers) ──
WORKER_1_PRIVATE_KEY=0x...
WORKER_2_PRIVATE_KEY=0x...
VERIFIER_1_PRIVATE_KEY=0x...
VERIFIER_2_PRIVATE_KEY=0x...

# ── OpenAI ──
OPENAI_API_KEY=sk-...

# ── Contract Addresses (from demo/deploy/addresses.sepolia.json) ──
CHAOS_CORE_ADDRESS=0xfBEE0CF0BB8bA4A6120B8b9aeB9BA0895EbaC877
CHAOSCHAIN_REGISTRY_ADDRESS=0x8C721d2A3d1FDe2B6F4234132214Ff9028E0312c
REWARDS_DISTRIBUTOR_ADDRESS=0x11aF07D8933a25B7fa32D06408d77a3ffaDcEAD1
CHAOSORACLE_REGISTRY_ADDRESS=0x4D067737D50bFeC0da87Cc782eA144Aeb24c05d5
EXAMPLE_MARKET_ADDRESS=0x64A52A8ce57291cA701F18376f26E224F7E2AEcb
LOGIC_MODULE_ADDRESS=0x689FD6DF59eeC5aB4729015cB238330a33a346c5

# ── Reused Sepolia Contracts ──
STUDIO_PROXY_FACTORY_ADDRESS=0x230e76a105A9737Ea801BB7d0624D495506EE257
IDENTITY_REGISTRY_ADDRESS=0x8004A818BFB912233c491871b3d84c89A494BD9e
REPUTATION_REGISTRY_ADDRESS=0x8004B663056A597Dffe9eCcC1965A193B7388713
VALIDATION_REGISTRY_ADDRESS=0x8004CB39f29c09145F24Ad9dDe2A108C1A2cdfC5
CRE_FORWARDER_ADDRESS=0x15fc6ae953e024d975e77382eeec56a9101f9f88

# ── Arweave ──
TURBO_GATEWAY_URL=https://turbo.ardrive.io

# ── Etherscan (for contract verification) ──
ETHERSCAN_API_KEY=...
