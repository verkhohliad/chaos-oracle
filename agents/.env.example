# ============================================================
# ChaosOracle Agent Configuration
# Copy this file to .env and fill in real values.
#
# docker-compose.yml defines 6 agents (3 workers + 3 verifiers),
# each with a unique wallet and model. Shared config below is
# loaded via env_file; per-agent overrides are in docker-compose.
# ============================================================

# ---- Agent wallets (6 unique funded Sepolia accounts) ----
# Each agent needs its own private key with Sepolia ETH for staking.
WORKER1_KEY=0xYOUR_WORKER1_KEY
WORKER2_KEY=0xYOUR_WORKER2_KEY
WORKER3_KEY=0xYOUR_WORKER3_KEY
VERIFIER1_KEY=0xYOUR_VERIFIER1_KEY
VERIFIER2_KEY=0xYOUR_VERIFIER2_KEY
VERIFIER3_KEY=0xYOUR_VERIFIER3_KEY

# ---- ChaosChain ----
CHAOSCHAIN_GATEWAY_URL=https://gateway.chaoscha.in
CHAOSCHAIN_NETWORK=ethereum_sepolia

# ---- Ethereum Sepolia RPC ----
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ---- Contract addresses (update after deployment) ----
CHAOS_ORACLE_REGISTRY_ADDRESS=0x6f1911A35fac05c0443c2a8E2d83d5d3A055764E
ERC_8004_IDENTITY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REPUTATION_CONTRACT_ADDRESS=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63

# ---- LLM (shared API key; per-agent model is set in docker-compose.yml) ----
# Models: worker-1/verifier-1 → gpt-5, worker-2/verifier-2 → gpt-4.1, worker-3/verifier-3 → gpt-5-mini
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE

# ---- Polling ----
POLL_INTERVAL_SECONDS=5

# ---- Staking (in wei) ----
WORKER_STAKE=1000000000000000
VERIFIER_STAKE=1000000000000000

# ---- Arweave (optional -- leave empty for stub CIDs in dev) ----
ARWEAVE_WALLET_PATH=
