# ChaosChain Gateway — multi-stage Docker build
# Built from the git submodule at external/chaoschain/packages/gateway

# ── Stage 1: Build ──
FROM node:20-slim AS builder
WORKDIR /app

# Copy package files first for layer caching
COPY external/chaoschain/packages/gateway/package.json ./
COPY external/chaoschain/packages/gateway/package-lock.json* ./

RUN npm ci --ignore-scripts

# Copy source and compile TypeScript
COPY external/chaoschain/packages/gateway/src/ src/
COPY external/chaoschain/packages/gateway/tsconfig.json ./
# Fix TS lint issues in submodule code (unused import: parseUnits)
RUN sed -i '/^  parseUnits,$/d' src/services/credit/circle-gateway-client.ts \
    && npx tsc

# ── Stage 2: Runtime ──
FROM node:20-slim
WORKDIR /app

# Install PostgreSQL client for running migrations
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled output and production dependencies
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# Copy migration SQL
COPY external/chaoschain/packages/gateway/src/persistence/postgres/migrations/ ./migrations/

EXPOSE 3000

# Run migrations then start the gateway
CMD ["sh", "-c", "psql \"$DATABASE_URL\" -f /app/migrations/001_initial.sql && node dist/app.js"]
