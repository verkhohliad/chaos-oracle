FROM python:3.12-slim

WORKDIR /app

# Install the full agent dependencies (excludes chaoschain-sdk — installed from local source below).
COPY agents/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install chaoschain-sdk from local source (with our fixes).
# This replaces the PyPI version installed via requirements.txt.
COPY external/chaoschain/packages/sdk/ /tmp/chaoschain-sdk/
RUN pip install --no-cache-dir /tmp/chaoschain-sdk/ && rm -rf /tmp/chaoschain-sdk/

# Copy ABIs (generated by forge build → scripts/export_abis.py)
COPY abis/ abis/

# Copy the real agent code from agents/
COPY agents/ .

# Create cache directory for ERC-8004 agent ID persistence.
# Docker volumes mount here to survive container rebuilds.
RUN mkdir -p /app/cache

# Entry point is set by docker-compose (worker.main or verifier.main)
CMD ["python", "-m", "worker.main"]
